{
  "name": "cloud-puffer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3030",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3030",
    "worker": "tsx --env-file=.env src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "dev:setup": "node scripts/setup.mjs",
    "infra": "docker compose -f compose.dev.yml up -d --wait",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm db:test && vitest run",
    "db:test": "tsx scripts/prepare-tests.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.82",
    "@base-ui/react": "1.9.0",
    "@better-auth/drizzle-adapter": "1.7.15",
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "ai": "7.0.159",
    "better-auth": "1.7.15",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
