# Local development; run pnpm run dev:setup to generate a private .env.
DATABASE_URL=postgresql://jojobot:local-development-only@127.0.0.1:55439/jojobot
BETTER_AUTH_URL=http://localhost:3030
BETTER_AUTH_SECRET=
CHANNEL_ENCRYPTION_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Cloud Puffer <hello@puffer.test>
# Choose openai-compatible (default), openai, anthropic, google, deepseek, or bailian.
# No browser receives this key. Bailian uses the Beijing pay-as-you-go URL by default.
MODEL_PROVIDER=openai-compatible
# Required for openai-compatible; for Bailian, set the URL matching your API key's region.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
DAILY_POINT_LIMIT=1000
ADMIN_EMAIL=
ILINK_ENABLED=false
# Shared QQ bot; configure after creating an app on the QQ Open Platform.
QQ_ENABLED=false
QQ_APP_ID=
QQ_APP_SECRET=
# Optional HTTPS link copied from the bot's sharing page.
QQ_BOT_URL=
# Shared Telegram bot; create a bot with BotFather before enabling.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
